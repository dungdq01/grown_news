# Khoá cửa LLM. Copy thành `.env` rồi điền — `.env*` đã gitignore.
# Một key cho mọi endpoint Beeknoee (guide §1).
BEEKNOEE_API_KEY=sk-bee-...

# Khoá dịch vụ giữa LÕI và THỢ. Hai tiến trình phải mang CÙNG một giá trị.
CHUNGCAT_KHOA_LOI=doi-thanh-mot-chuoi-rieng

# Khoá chiều THỢ → LÕI (FR-047). PHẢI KHÁC `KHOA_PHIEN` — dùng chung một
# secret cho session và dịch vụ nội bộ là CVE-2025-41258.
KHOA_DICH_VU=doi-thanh-mot-chuoi-rieng
KHOA_PHIEN=mot-chuoi-KHAC-HAN
